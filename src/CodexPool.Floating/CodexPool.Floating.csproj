<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/codex-pool.ico</ApplicationIcon>
    <!-- Settings tray reads these. AssemblyName stays CodexPool.Floating so paths and shortcuts keep working. -->
    <Product>Codex Pool</Product>
    <AssemblyTitle>Codex Pool</AssemblyTitle>
    <FileDescription>Codex Pool</FileDescription>
    <!-- WPF owns startup. The tray uses WinForms interop, not its generated DPI entry point. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../CodexPool.Daemon/CodexPool.Daemon.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="../../assets/codex-pool.ico" Link="Assets/codex-pool.ico" /></ItemGroup>
  <ItemGroup>
    <!-- Use Windows pointer input rather than the legacy tablet service. This
         must be configured before WPF initializes its input manager. -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Input.Stylus.EnablePointerSupport" Value="true" />
  </ItemGroup>
</Project>
