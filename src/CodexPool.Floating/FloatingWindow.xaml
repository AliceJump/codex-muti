<Window x:Class="CodexPool.Floating.FloatingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex Pool" Width="336" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" Background="Transparent" FontFamily="Segoe UI Variable, Segoe UI">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="16" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
  <Border x:Name="Surface" Background="{DynamicResource SurfaceBrush}" CornerRadius="16" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Padding="18,14">
    <StackPanel><Grid x:Name="Header" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel MouseLeftButtonDown="DragHeader" Cursor="SizeAll"><TextBlock Text="Codex Pool" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="Connection" Text="连接中" FontSize="11" Opacity="0.6" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="◫" Click="CycleMode" ToolTip="完整 / 紧凑 / 胶囊"/><Button Content="◐" Click="CycleTheme" ToolTip="自动 / 浅色 / 深色"/><Button Content="—" Click="HideWindow" ToolTip="隐藏到托盘 (Ctrl+Alt+C)"/></StackPanel></Grid><ScrollViewer x:Name="AccountScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Accounts"/></ScrollViewer><Grid x:Name="Footer" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="AutoStatus" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Dashboard ↗" Click="OpenDashboard" FontSize="11"/></Grid><TextBlock x:Name="Notice" TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,8,0,0" Visibility="Collapsed"/></StackPanel>
  </Border>
</Window>
