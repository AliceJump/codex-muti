<Window x:Class="CodexPool.Floating.FloatingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex Pool" Width="336" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" Background="Transparent" FontFamily="Segoe UI Variable, Segoe UI">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="16" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
  <Grid x:Name="MotionHost">
  <Border x:Name="Surface" Background="{DynamicResource SurfaceBrush}" CornerRadius="16" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Padding="18,14" MouseLeftButtonDown="DragCapsule">
    <Grid x:Name="LayoutContent">
    <Canvas x:Name="MotionBackdrops" IsHitTestVisible="False"/>
    <StackPanel>
      <Grid x:Name="Header" Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel MouseLeftButtonDown="DragHeader" Cursor="SizeAll">
          <TextBlock x:Name="HeaderTitle" Text="Codex Pool" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="Connection" Text="连接中" FontSize="11" Opacity="0.6" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button x:Name="PinButton" Content="○" Click="TogglePin" ToolTip="置顶 / 取消置顶" Visibility="Collapsed" Padding="6,5"/>
          <Button Content="◫" Click="CycleMode" ToolTip="完整 / 紧凑 / 胶囊" Padding="6,5"/>
          <Button Content="◐" Click="CycleTheme" ToolTip="自动 / 浅色 / 深色" Padding="6,5"/>
          <Button x:Name="DismissButton" Content="—" Click="DismissWindow" ToolTip="隐藏窗口" Padding="6,5"/>
        </StackPanel>
      </Grid>
      <Border x:Name="WidgetSummary" Visibility="Collapsed" Padding="12" Margin="0,0,0,12" CornerRadius="12" Background="#1867A2F3">
        <StackPanel>
          <TextBlock Text="当前账户" FontSize="10" Opacity="0.55"/>
          <TextBlock x:Name="WidgetActive" Text="正在连接代理…" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="WidgetDetail" Text="账户额度与状态实时同步" FontSize="10" Opacity="0.55" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>
      <ScrollViewer x:Name="AccountScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Accounts"/></ScrollViewer>
      <StackPanel x:Name="Footer" Margin="0,8,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="AutoStatus" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="Web 面板 ↗" Click="OpenDashboard" FontSize="11"/>
        </Grid>
        <Grid x:Name="WidgetActions" Visibility="Collapsed" Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button Content="打开悬浮窗" Click="OpenFloating" Background="#2267A2F3" Padding="10,9" Margin="0"/>
          <Button Grid.Column="2" Content="刷新额度" Click="RefreshQuota" Background="#228799AB" Padding="10,9" Margin="0"/>
          <Button Grid.Column="4" Content="打开 Web" Click="OpenDashboard" Background="#168799AB" Padding="10,9" Margin="0"/>
        </Grid>
      </StackPanel>
      <TextBlock x:Name="Notice" TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,8,0,0" Visibility="Collapsed"/>
    </StackPanel>
    </Grid>
  </Border>
  <Canvas x:Name="MotionLayer" IsHitTestVisible="False" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Top"/>
  </Grid>
</Window>
